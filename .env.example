# Variáveis para rodar a app, as migrations e os testes a partir do host,
# apontando para os containers do docker compose. Copie para `.env`.
# Dentro do compose os valores são definidos no próprio docker-compose.yml.

PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Opcionais (valores padrão abaixo)
# LOG_LEVEL=info            # debug, info, warn, error ou silent; logs são uma linha JSON por evento no stdout
# DB_POOL_MAX=10            # conexões do pool por instância
# DB_LOCK_TIMEOUT_MS=5000   # espera máxima pelo lock de uma wallet; estourou vira 503
# SQS_CONSUMER_ENABLED=true           # false: a instância só atende HTTP
# SQS_CONSUMER_CONCURRENCY=5          # workers; cada um processa uma mensagem por vez
# SQS_WAIT_TIME_SECONDS=10            # long polling; também o tempo máximo para parar de buscar no shutdown
# SQS_VISIBILITY_TIMEOUT_SECONDS=30   # tem que ser maior que DB_LOCK_TIMEOUT_MS, senão a app não sobe
# SQS_MAX_ATTEMPTS=5                  # deve ser igual ao maxReceiveCount da fila
# SQS_RETRY_BASE_DELAY_SECONDS=2      # backoff de retry: 2s, 4s, 8s... até 60s
# SQS_SHUTDOWN_GRACE_MS=20000
# OUTBOX_PUBLISHER_ENABLED=true       # false: a instância não publica eventos
# OUTBOX_POLL_INTERVAL_MS=500         # espera entre ciclos quando não há lote cheio
# OUTBOX_BATCH_SIZE=10                # máximo 10 (limite de um SendMessageBatch)
# OUTBOX_RETRY_BASE_DELAY_MS=1000     # backoff de publicação: 1s, 2s, 4s... até o teto, sem limite de tentativas
# OUTBOX_RETRY_MAX_DELAY_MS=60000
# OUTBOX_SEND_TIMEOUT_MS=5000         # prazo do envio ao SQS (a linha da outbox fica travada durante o envio)
# PENDING_REFERENCE_WORKER_ENABLED=true
# PENDING_REFERENCE_POLL_INTERVAL_MS=1000
# PENDING_REFERENCE_BATCH_SIZE=20
# PENDING_REFERENCE_RETRY_BASE_DELAY_MS=5000    # 5s, 10s, 20s... até o teto
# PENDING_REFERENCE_RETRY_MAX_DELAY_MS=300000
# PENDING_REFERENCE_MAX_ATTEMPTS=8              # ~15 min no total; esgotou -> REJECTED REFERENCE_NOT_FOUND
